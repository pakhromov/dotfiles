#!/usr/bin/env python3

import os
import subprocess
import threading
import time
from urllib.parse import unquote, urlparse

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

BUS_NAME = "org.freedesktop.FileManager1"
OBJ_PATH = "/org/freedesktop/FileManager1"

YA = "/usr/bin/ya"
KITTY = ["/usr/bin/kitty", "@", "--to", "unix:@mykitty"]
YAZI_MATCH = "cmdline:yazi"
YAZI_CLASS = "yazi"

IDLE_SECONDS = 10
RETRIES = 50
RETRY_DELAY = 0.1


def uri_to_path(uri):
    if uri.startswith("/"):
        return uri
    parts = urlparse(uri)
    if parts.scheme != "file" or parts.netloc not in ("", "localhost"):
        return None
    return unquote(parts.path) or None


def ya_emit(*args):
    return subprocess.run(
        [YA, *args],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0


def kitty_rc(*args):
    return subprocess.run(
        [*KITTY, *args],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0


def focus_or_launch():
    if kitty_rc("focus-window", "--match", YAZI_MATCH):
        return
    kitty_rc("launch", "--type=os-window",
             "--os-window-class", YAZI_CLASS, "yazi")


def navigate(target_dir, target_file):
    if not ya_emit("emit-to", "0", "plugin", "--str", "write-id", target_dir):
        return False
    if target_file:
        ya_emit("emit-to", "0", "reveal", "--str", target_file)
    return True


def show(target_dir, target_file):
    running = navigate(target_dir, target_file)
    focus_or_launch()
    if running:
        return
    for _ in range(RETRIES):
        time.sleep(RETRY_DELAY)
        if navigate(target_dir, target_file):
            return


class FileManager1(dbus.service.Object):
    def __init__(self, bus, loop):
        super().__init__(bus, OBJ_PATH)
        self.loop = loop
        self.jobs = 0
        self.lock = threading.Lock()
        self.deadline = time.monotonic() + IDLE_SECONDS
        GLib.timeout_add_seconds(1, self.tick)

    def tick(self):
        with self.lock:
            busy = self.jobs > 0
        if busy:
            self.deadline = time.monotonic() + IDLE_SECONDS
        elif time.monotonic() >= self.deadline:
            self.loop.quit()
            return False
        return True

    def dispatch(self, uris, folders):
        path = next((p for p in map(uri_to_path, uris) if p), None)
        if not path:
            return
        if folders:
            target_dir, target_file = path, None
        else:
            target_dir, target_file = os.path.dirname(path), path

        with self.lock:
            self.jobs += 1

        def run():
            try:
                show(target_dir, target_file)
            finally:
                with self.lock:
                    self.jobs -= 1

        threading.Thread(target=run, daemon=True).start()

    @dbus.service.method(BUS_NAME, in_signature="ass")
    def ShowItems(self, uris, startup_id):
        self.dispatch(uris, folders=False)

    @dbus.service.method(BUS_NAME, in_signature="ass")
    def ShowFolders(self, uris, startup_id):
        self.dispatch(uris, folders=True)

    @dbus.service.method(BUS_NAME, in_signature="ass")
    def ShowItemProperties(self, uris, startup_id):
        self.dispatch(uris, folders=False)


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    try:
        name = dbus.service.BusName(BUS_NAME, bus, do_not_queue=True)
    except dbus.exceptions.NameExistsException:
        raise SystemExit(f"{BUS_NAME} is already owned by another process")
    loop = GLib.MainLoop()
    service = FileManager1(bus, loop)
    service.name = name
    loop.run()


if __name__ == "__main__":
    main()
