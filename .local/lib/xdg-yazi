#!/bin/zsh
arg="$1"

if [ -d "$arg" ]; then
    target_dir="$arg"
else
    target_dir=$(dirname "$arg")
    target_file="$arg"
fi

args="${(qq)target_dir}"
[ -n "$target_file" ] && args+=" ${(qq)target_file}"

ya emit-to 0 plugin focus-dir-tab "$args" &>/dev/null

kitty @ --to unix:@mykitty focus-window --match cmdline:yazi &>/dev/null && exit
kitty @ --to unix:@mykitty launch --type=os-window --os-window-class yazi env "YAZI_OPEN=$args" yazi &>/dev/null && exit
kitty --single-instance --listen-on="unix:@mykitty" --class yazi env "YAZI_OPEN=$args" yazi &>/dev/null &!
