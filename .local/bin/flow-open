#!/bin/bash
# Open files in the running "main" flow editor, or start it with the last set of tabs.
name=main
proj=$(realpath "$HOME")
state="${XDG_STATE_HOME:-$HOME/.local/state}/flow"
sock="$state/run/$name.sock"
session="$state/sessions/$(printf '%s' "$proj" | sed 's|/|__|g; s|:|___|g')"

if ss -xlH | grep -qF "$sock"; then
    exec flow --connect "$name" --no-wait "$@"
fi

# Not running: read the tab list from flow's session file (paths only, never the stored text)
tabs=()
if [[ -f $session ]]; then
    mapfile -d '' tabs < <(python3 - "$session" "$proj" <<'EOF'
import os, sys, cbor2
path, proj = sys.argv[1], sys.argv[2]
try:
    with open(path, "rb") as f:
        d = cbor2.CBORDecoder(f, str_errors="surrogateescape")
        d.decode()               # project
        active = d.decode()      # active file
        d.decode()               # clipboard
        d.decode()               # buffers (contain stored text, ignored)
        tabs = d.decode()        # visible tabs, in order
except Exception:
    sys.exit(0)
order = [t for t in tabs if t and t != active] + ([active] if active else [])
for t in order:
    p = os.path.join(proj, t)    # session paths are relative to the project, or absolute
    if os.path.isfile(p):
        sys.stdout.write(p + "\0")
EOF
)
fi

rm -f "$sock"
exec launch-or-focus.sh -w 4 --single-class flow kitty --single-instance --listen-on=unix:@mykitty --class flow flow --server "$name" -p "$proj" "${tabs[@]}" "$@"