#!/bin/sh
set -eu

[ $# -eq 0 ] && { printf 'Usage: launch <compositor>\n' >&2; exit 1; }
compositor="$1"

dbus_env="/tmp/dbus-$USER.env"
# Create new bus if file doesn't exist
if [ ! -f "$dbus_env" ]; then
    dbus-daemon --session --fork --print-address=1 --print-pid=1 > "$dbus_env"
else
    DBUS_SESSION_BUS_ADDRESS="$(sed -n '1p' "$dbus_env")"
    export DBUS_SESSION_BUS_ADDRESS
    # If bus is dead
    if ! dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.GetId >/dev/null 2>&1; then
        dbus-daemon --session --fork --print-address=1 --print-pid=1 > "$dbus_env"
    fi
fi
DBUS_SESSION_BUS_ADDRESS="$(sed -n '1p' "$dbus_env")"
export DBUS_SESSION_BUS_ADDRESS

export PATH="$HOME/.local/bin:$PATH"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"
export EDITOR="subl"
export VISUAL="$EDITOR"
export TERMINAL="kitty"
export BROWSER="firefox"
export XCURSOR_SIZE=24

export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
export GTK2_RC_FILES="$XDG_CONFIG_HOME/gtk-2.0/gtkrc"
export TERMINFO="$XDG_DATA_HOME"/terminfo
export TERMINFO_DIRS="$XDG_DATA_HOME"/terminfo:/usr/share/terminfo
export CODEX_HOME="$XDG_CONFIG_HOME"/codex
export CARGO_HOME="$XDG_DATA_HOME"/cargo
export NPM_CONFIG_USERCONFIG=$XDG_CONFIG_HOME/npm/npmrc
export WGETRC="$XDG_CONFIG_HOME/wgetrc"

export NO_AT_BRIDGE=1

export GBM_BACKEND=nvidia-drm
export NVD_BACKEND=direct
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export LIBVA_DRIVER_NAME=nvidia
export MOZ_DISABLE_RDD_SANDBOX=1
export CUDA_DISABLE_PERF_BOOST=1
export ELECTRON_OZONE_PLATFORM_HINT=auto

export WAYFIRE_PLUGIN_PATH="$HOME/Projects/wayfire-plugins/src"
export WAYFIRE_PLUGIN_XML_PATH="$HOME/Projects/wayfire-plugins/metadata"

export LD_LIBRARY_PATH=/home/pavel/Projects/wayfire-fix/wlroots/build

log="/tmp/$compositor.log"

case "$compositor" in
    jay)   exec jay run </dev/null >"$log" 2>&1 ;;
    kwin)
        # This build of kwin_wayland links libKGlobalAccelD directly
        # (ldd shows libKGlobalAccelD.so.0) and owns org.kde.kglobalaccel
        # on the session bus itself - no external kglobalacceld needed or
        # wanted; starting one just fights kwin for the D-Bus name.
        #
        # KWin's KPackage-based script loading (the kwinrc [Plugins]
        # "*Enabled=true" mechanism kpackagetool6-installed scripts rely
        # on) is broken here: Scripting.loadScript(path, pluginName)
        # returns -1 for any installed KWin/Script package, even stock
        # ones. Scripting.loadScript(path) with no pluginName works fine
        # and registers shortcuts correctly, so load our scripts that way
        # by hand once org.kde.KWin appears on the bus.
        # D-Bus-activated services (like dbus-app-launcher, which our
        # launchkitty script calls into) are spawned by dbus-daemon itself.
        # Our private dbus-daemon starts before kwin picks a WAYLAND_DISPLAY,
        # so activated services never inherit it and can't open windows -
        # confirmed dbus-app-launcher launches kitty fine when WAYLAND_DISPLAY
        # is set, but silently does nothing without it. Push it into the
        # daemon's activation environment once kwin creates its socket.
        runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
        before_locks=$(ls "$runtime_dir"/wayland-*.lock 2>/dev/null || true)
        (
            kwin_script_log="/tmp/kwin-scripts.log"
            : > "$kwin_script_log"

            i=0
            found=""
            while [ "$i" -lt 100 ]; do
                for lockfile in "$runtime_dir"/wayland-*.lock; do
                    [ -e "$lockfile" ] || continue
                    case " $before_locks " in
                        *" $lockfile "*) continue ;;
                    esac
                    found="$lockfile"
                    break
                done
                [ -n "$found" ] && break
                i=$((i + 1))
                sleep 0.1
            done
            if [ -n "$found" ]; then
                WAYLAND_DISPLAY=$(basename "$found" .lock)
                export WAYLAND_DISPLAY
                echo "wayland display: $WAYLAND_DISPLAY" >>"$kwin_script_log"
                dbus-update-activation-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR >>"$kwin_script_log" 2>&1
            else
                echo "timed out waiting for wayland socket" >>"$kwin_script_log"
            fi

            j=0
            while [ "$j" -lt 100 ]; do
                owned=$(dbus-send --session --print-reply \
                    --dest=org.freedesktop.DBus /org/freedesktop/DBus \
                    org.freedesktop.DBus.NameHasOwner string:org.kde.KWin 2>/dev/null)
                case "$owned" in
                    *boolean\ true*) break ;;
                esac
                j=$((j + 1))
                sleep 0.1
            done
            for script in launchkitty; do
                path="/home/pavel/.local/share/kwin/scripts/$script/contents/code/main.js"
                id=$(qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$path" 2>>"$kwin_script_log")
                echo "$script -> id $id" >>"$kwin_script_log"
                qdbus6 org.kde.KWin "/Scripting/Script$id" org.kde.kwin.Script.run >>"$kwin_script_log" 2>&1
            done
        ) &
        # kwin_wayland starts locked by default, and the greeter crashes in
        # a loop here (needs org.kde.plasma.private.sessions from
        # plasma-workspace, which isn't installed) - global shortcuts stay
        # suppressed the whole time since KWin considers itself locked.
        # There's no lockscreen module in this setup anyway, so disable it.
        exec kwin_wayland --no-lockscreen </dev/null >"$log" 2>&1 ;;
    river) exec river -no-xwayland </dev/null >"$log" 2>&1 ;;
    sway)  exec sway --unsupported-gpu </dev/null >"$log" 2>&1 ;;
    wayfire) exec wayfire -d </dev/null >"$log" 2>&1 ;;
    *)     exec "$compositor" </dev/null >"$log" 2>&1 ;;
esac
