#!/bin/sh
if [ "$1" = "--prompt" ]; then
    fifo=$(mktemp -u)
    mkfifo "$fifo"
    inner=$(mktemp)
    cat > "$inner" <<EOF
trap 'printf "%s" "\$pw" > "$fifo"' EXIT
cowsay PASSWORD PLEASE | lolcat
read -s -p 'Password: ' pw
EOF
    keep-focused-launch.py float-polkit -- kitty --single-instance --class float-polkit bash "$inner"
    timeout 30 cat "$fifo"
    rm -f "$fifo" "$inner"
else
    exec mini-polkit "$0 --prompt"
fi
