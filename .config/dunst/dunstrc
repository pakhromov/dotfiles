[global]
    #monitor = DP2
    #follow = mouse
    layer = overlay
    width = 300
    height = (0, 300)
    offset = (20, 20)
    format = "<i><b>%s</b></i>\n%b"
    dmenu = rofi -dmenu dunst:

    sort = true
    origin = top-right
    notification_limit = 10
    sticky_history = false
    history_length = 0
    ignore_dbusclose = true
    show_indicators = false
    ignore_newline = true
    stack_duplicates = false
    hide_duplicate_count = true
    indicate_hidden = true
    idle_threshold = 0
    show_age_threshold = "1m"

    highlight = "#3e999f"
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 400
    progress_bar_corner_radius = 5
    icon_corner_radius = 0

    padding = 10
    horizontal_padding = 10
    text_icon_padding = 10
    frame_width = 2
    frame_color = "#FFFFFF"
    gap_size = 10
    corner_radius = 6

    font = ComicShannsLigaMod Nerd Font 12
    line_height = 2
    alignment = left
    vertical_alignment = center
    ellipsize = middle

    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    mouse_left_click = do_action, close_current
    mouse_middle_click = context
    mouse_right_click = close_current


[all]
    override_dbus_timeout = 0
    timeout = 0
    history_ignore = true
    default_icon = dialog-information
    background = "#000000"
    foreground = "#ffffff"


[gpu_sr]
    appname = "com.dec05eba.gpu_screen_recorder"
    timeout = 2
