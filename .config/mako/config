layer=overlay

markup=1
format= <i><b>%s</b></i>\n%b
max-history=0
history=0
actions=1
icons=1
default-timeout=0
ignore-timeout=1
ignore-replace=1
ignore-close=1

anchor=top-right
max-visible=10
sort=+time

font=ComicShannsLigaMod Nerd Font 12
text-alignment=left

on-button-left=invoke-default-action
on-button-middle=exec keep-focused-launch.py float-half -- kitty --single-instance --class float-half makoctl menu -n $id -- fzf
on-button-right=dismiss
on-touch=invoke-default-action

background-color=#000000
text-color=#FFFFFF
border-color=#FFFFFF
progress-color=over #3e999f

width=300
height=300
outer-margin=10
margin=10
padding=10

border-size=2
border-radius=6

max-icon-size=48
icon-location=left
icon-border-radius=0
icon-path=/usr/share/icons/Cosmic/scalable/status:/usr/share/icons/Cosmic/scalable/devices:/usr/share/icons/Cosmic/scalable/apps

[app-name=osd]
ignore-timeout=0
ignore-replace=0
ignore-close=0
