# Kitty — imported from ~/.config/kitty (background #111111 / foreground #A0A0A0)

background = #111111
foreground = #A0A0A0

# kitty had `cursor none` (cursor takes the color of the text under it).
# Monstar has no such mode, so the cursor is pinned to the foreground.
cursor-color = #A0A0A0
cursor-text  = #111111

# kitty had `selection_foreground/background none`, i.e. reverse video.
# Reproduced statically as a foreground/background swap.
selection-background = #A0A0A0
selection-foreground = #111111
# Muted alternative, if the swap is too bright:
# selection-background = #2F3334
# selection-foreground = #F8F8F2

