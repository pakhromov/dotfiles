%YAML 1.2
---
name: Config
file_extensions:
  - conf
  - config
  - cfg
  - gitconfig
  - editorconfig
hidden_file_extensions:
  - gitmodules
  - gitattributes
  - env
scope: source.config

contexts:
  main:
    - include: comment
    - include: section
    - match: '[{}]'
      scope: punctuation.bracket.config
    - include: command
    - include: string-double
    - include: string-single
    - include: number
    - include: variable

  comment:
    - match: '[#;].*$'
      scope: comment.line.config

  section:
    - match: '^\s*(\[)'
      captures:
        1: punctuation.bracket.config
      push: section-body

  section-body:
    - match: '\]'
      scope: punctuation.bracket.config
      pop: true
    - include: string-double
    - include: string-single
    - match: '[^"'' \t\n\]]+'
      scope: entity.name.section.config

  command:
    - match: '^\s*([^"''{}()#;=, \t\n]+)(?=\s*\{)'
      captures:
        1: entity.name.section.config
      push: args
    - match: '^\s*([^"''{}()#;=, \t\n]+)(?=[\s"''{}()#;=,\n]|$)'
      captures:
        1: entity.name.function.config
      push: args

  args:
    - match: $
      pop: true
    - match: '#(?![0-9a-fA-F]).*$'
      scope: comment.line.config
    - include: escape
    - include: string-double
    - include: string-single
    - include: variable
    - include: number
    - match: '(?<!\w)(?=[0-9a-fA-F]*[a-fA-F])[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?(?!\w)'
      scope: constant.numeric.config
    - match: '\b(true|false)\b'
      scope: constant.language.config
    - match: '[\[{(]'
      scope: punctuation.bracket.config
    - match: '[\]})]'
      scope: punctuation.bracket.config
    - match: '[,]'
      scope: punctuation.delimiter.config
    - match: '[^"''{}()=, \t\n]+'

  string-double:
    - match: '"'
      scope: punctuation.definition.string.begin.config
      push:
        - meta_scope: string.quoted.double.config
        - match: '"'
          scope: punctuation.definition.string.end.config
          pop: true
        - include: escape
        - include: variable

  string-single:
    - match: "(?<!\\w)'"
      scope: punctuation.definition.string.begin.config
      push:
        - meta_scope: string.quoted.single.config
        - match: "'"
          scope: punctuation.definition.string.end.config
          pop: true
        - match: $
          pop: true

  escape:
    - match: '\\(?:x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{1,4}|U[0-9a-fA-F]{1,8}|[0-7]{1,3}|.)'
      scope: constant.character.escape.config

  variable:
    - match: '\$\{[\w]+\}|\$[\w]+'
      scope: variable.other.config

  number:
    - match: '(?<!\w)[+-]?[0-9]+(\.[0-9]+)?%?(?!\w)'
      scope: constant.numeric.config
