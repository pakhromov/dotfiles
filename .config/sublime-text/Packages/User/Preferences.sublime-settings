{
	"enable_telemetry": false,
	"hardware_acceleration": "none", //opengl, none
	"ui_scale": 1.0,
	"scroll_speed": 0.5,
	"hide_pointer_while_typing": true,
	"reload_file_in_background": true,
	"theme": "Base.hidden-theme",
	"color_scheme": "Packages/Colorscheme/Cyanide - Wood - Contrasted.tmTheme",
	"enable_tab_scrolling": true,
	"adaptive_dividers": false,
	"show_sidebar_button": false,
	"show_line_endings": true,
	"show_line_column": "disabled",
	"margin": 4,
	"show_encoding": true,
	"draw_white_space": ["selection", "trailing", "isolated"],
	"close_windows_when_empty": true,
	"git_diff_target": "index",
	"index_files": false,
	"show_definitions": false,
	"font_face": "ComicShannsLigaMod Nerd Font",
	"font_size": 13,
	"caret_style": "solid", //"smooth", "phase", "blink" and "solid"
	"block_caret": false,
	"caret_extra_top": 4,
	"caret_extra_bottom": 4,
	"caret_extra_width": 1,
	"highlight_line": true,
	"match_selection": false,
	"line_padding_bottom": 0,
	"line_padding_top": 0,
	"translate_tabs_to_spaces": true,
	"trim_trailing_white_space_on_save": "all",
	"trim_only_modified_white_space": false,
	"bold_folder_labels": true,
	"word_separators": "./\\()\"':,.;<>~!@#$%^&*|+=[]{}`~?",
	"sub_word_separators": "_-",
	"control_character_style": "names",
	"tab_size": 4,
	"indent_to_bracket": true,
	"match_brackets_angle": true,
	"word_wrap": true,
	"wrap_width": 0,
	"spell_check": true,
	"show_spelling_errors": false,
	"spelling_selector": "(text.html.markdown, text.tex.latex, text.plain, text.restructuredtext, text.html.textile, text.git-commit) - (markup.raw, markup.underline.link, meta.tag, support.function, constant.character)",
	"auto_complete_delay": 0,
	"tab_completion": true,
	"auto_complete": true,
	"auto_complete_selector": "meta.tag, source - comment - string.quoted.double.block - string.quoted.single.block - string.unquoted.heredoc",
	"auto_complete_commit_on_tab": false,
	"auto_complete_with_fields": false,
	"auto_complete_cycle": true,
	"auto_complete_use_history": true,
	"auto_complete_preserve_order": "some",
	"copy_with_empty_selection": false,
	"close_find_after_find_all": false,
	"close_find_after_replace_all": false,
	"find_in_files_side_by_side": true,
	"focus_on_file_drop": true,
	"drag_text": false,
	"allow_git_home_dir": true,
	"preview_on_click": false,
	"ignored_packages": ["Vintage"],
	"fonts_list":
